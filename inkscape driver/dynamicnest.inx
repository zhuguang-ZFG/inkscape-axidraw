<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>DynamicNest 高级控制</name>
  <id>command.dynamicnest.manager</id>
  <dependency type="extension">org.inkscape.output.svg.inkscape</dependency>
  <dependency type="executable" location="extensions">dynamicnest_control.py</dependency>

  <param name="mode" type="notebook">

    <page name="plot" gui-text="缁樺浘">
      <label appearance="header">缁樺浘浠诲姟</label>
      <label xml:space="preserve">榛樿鎸夋墍鏈夊彲瑙佸浘灞傞『搴忕粯鍒躲€傝秴鍑烘満鍣ㄨ绋嬫椂锛岄粯璁や細鍏堣嚜鍔ㄧ缉鏀炬暣鍥鹃€傞厤锛屽啀淇濈暀瓒婄晫瑁佸垏浣滀负鏈€鍚庝繚鎶ゃ€?/label>
      <spacer />
      <param name="copies" type="int" min="0" max="9999" gui-text="缁樺浘浠芥暟锛?>1</param>
      <param name="page_delay" type="int" min="0" max="3600" gui-text="姣忎唤闂撮殧锛堢锛夛細">15</param>
      <param name="preview" type="bool" gui-text="浠呴瑙堬紝涓嶅彂閫佷覆鍙?>false</param>
      <param name="report_time" type="bool" gui-text="瀹屾垚鍚庢姤鍛婅€楁椂">false</param>
      <param name="rendering" type="optiongroup" appearance="combo" gui-text="棰勮鏄剧ず锛?>
        <option value="3">鍏ㄩ儴杩愬姩</option>
        <option value="1">浠呰惤绗旇建杩?/option>
        <option value="2">浠呮姮绗旇建杩?/option>
        <option value="0">涓嶆樉绀?/option>
      </param>
      <spacer />
      <param name="auto_pause_between_layers" type="bool" gui-text="鍥惧眰闂磋嚜鍔ㄦ殏鍋?>true</param>
      <param name="manual_pen_change" type="bool" gui-text="鏆傚仠鏃惰繘鍏ユ墜鍔ㄦ崲绗旀祦绋?>true</param>
      <param name="pen_change_to_home" type="bool" gui-text="鎹㈢瑪鏃跺厛鍥炲伐浣滃師鐐?>true</param>
      <param name="grbl_return_to_origin_after_plot" type="bool" gui-text="瀹屾垚鍚庤嚜鍔ㄥ洖宸ヤ綔鍘熺偣">true</param>
      <spacer />
      <label>鎻愮ず锛氫唤鏁拌涓?0 琛ㄧず杩炵画缁樺浘銆?/label>
    </page>

    <page name="manual" gui-text="蹇€熻酱鎺?>
      <label appearance="header">蹇€熻酱鎺?/label>
      <label xml:space="preserve">杩欓〉浼樺厛鏀惧父鐢ㄧ偣鍔ㄥ拰鍘熺偣鎿嶄綔锛涢€変竴涓姩浣滃悗鐐瑰嚮鈥滃簲鐢ㄢ€濄€傝瘖鏂」鏀惧湪鍚庨潰锛屽噺灏戞潵鍥炴壘鎸夐挳銆?/label>
      <label>涓婂崐閮ㄥ垎鏄棩甯告帶鍒堕」锛涢潬鍚庣殑鈥滆鍙栫姸鎬?鎵弿涓插彛/璇诲彇杞磋缃?璇诲浐浠垛€濆睘浜庤瘖鏂」銆?/label>
      <spacer />
      <param name="manual_cmd" type="optiongroup" appearance="radio" gui-text="鍔ㄤ綔锛?>
        <option value="walk_mmy_pos">Y+ 鐐瑰姩</option>
        <option value="walk_mmy_neg">Y- 鐐瑰姩</option>
        <option value="walk_mmx_neg">X- 鐐瑰姩</option>
        <option value="walk_mmx_pos">X+ 鐐瑰姩</option>
        <option value="raise_pen">Z 鎶瑪</option>
        <option value="lower_pen">Z 钀界瑪</option>
        <option value="jog_stop">鍋滄褰撳墠鐐瑰姩/杩愬姩</option>
        <option value="walk_home">鍥炲伐浣滃師鐐?/option>
        <option value="set_origin_here">灏嗗綋鍓嶇偣璁句负鍘熺偣</option>
        <option value="enable_xy">瑙ｉ攣/浣胯兘鐢垫満锛?X锛?/option>
        <option value="disable_xy">澶辫兘鐢垫満</option>
        <option value="status_refresh">璇诲彇褰撳墠浣嶇疆/鐘舵€?/option>
        <option value="home_cycle">鏈烘褰掍綅锛?H锛?/option>
        <option value="sync_canvas_to_machine">璇诲彇鏈哄櫒琛岀▼骞舵洿鏂扮敾甯冧笖绛夋瘮缂╂斁鏁村浘</option>
        <option value="ports_scan">鎵弿涓插彛鍒楄〃</option>
        <option value="axis_read">璇诲彇鍧愭爣杞磋缃?/option>
        <option value="fw_version">璇诲彇鍥轰欢鐗堟湰</option>
        <option value="strip_data">娓呴櫎 SVG 鎭㈠鏁版嵁</option>
        <option value="none">涓嶆墽琛?/option>
      </param>
      <param name="manual_jog_step_preset" type="optiongroup" appearance="combo" gui-text="甯哥敤姝ヨ窛棰勮锛?>
        <option value="1">1 mm锛堟帹鑽愶級</option>
        <option value="0.1">0.1 mm</option>
        <option value="5">5 mm</option>
        <option value="10">10 mm</option>
        <option value="custom">鑷畾涔?/option>
      </param>
      <param name="dist" type="float" precision="3" min="0.001" max="100000" gui-text="鐐瑰姩璺濈锛坢m锛夛細">1.000</param>
      <param name="manual_jog_repeat" type="int" min="1" max="200" gui-text="杩炵画鐐瑰姩娆℃暟锛?>1</param>
      <param name="manual_auto_status_refresh" type="bool" gui-text="鐐瑰姩鍚庤嚜鍔ㄥ埛鏂板潗鏍?>true</param>
      <label>璇存槑锛氭璺濋璁句笉涓衡€滆嚜瀹氫箟鈥濇椂锛屼細浼樺厛浣跨敤棰勮鍊硷紱杩炵画鐐瑰姩浠嶇劧璧版彃浠惰繖鏉¤矾锛屼笉鏄湡姝ｆ寜浣忓疄鏃讹紝浣嗘瘮鍗曟鐐瑰姩鏇撮『鎵嬨€?/label>
    </page>

    <page name="options" gui-text="鍩虹鍙傛暟">
      <label appearance="header">鍩虹鍙傛暟</label>
      <param name="speed_pendown" type="int" min="1" max="110" gui-text="钀界瑪閫熷害锛?>25</param>
      <param name="speed_penup" type="int" min="1" max="110" gui-text="鎶瑪閫熷害锛?>75</param>
      <param name="accel" type="optiongroup" appearance="combo" gui-text="鍔犻€熷害锛?>
        <option value="50">鏍囧噯</option>
        <option value="100">鏈€澶?/option>
        <option value="75">杈冮珮</option>
        <option value="35">杈冩參</option>
        <option value="10">寰堟參</option>
      </param>
      <param name="const_speed" type="bool" gui-text="钀界瑪鏃舵亽閫?>false</param>
      <spacer />
      <param name="pen_pos_up" type="int" min="0" max="100" gui-text="鎶瑪楂樺害锛?>60</param>
      <param name="pen_pos_down" type="int" min="0" max="100" gui-text="钀界瑪楂樺害锛?>30</param>
      <param name="pen_rate_raise" type="int" min="1" max="200" gui-text="鎶瑪閫熷害锛?>75</param>
      <param name="pen_rate_lower" type="int" min="1" max="200" gui-text="钀界瑪閫熷害锛?>50</param>
      <param name="pen_delay_up" type="int" min="-500" max="500" gui-text="鎶瑪闄勫姞寤舵椂锛坢s锛夛細">0</param>
      <param name="pen_delay_down" type="int" min="-500" max="500" gui-text="钀界瑪闄勫姞寤舵椂锛坢s锛夛細">0</param>
    </page>

    <page name="advanced" gui-text="楂樼骇璁剧疆">
      <label appearance="header">楂樼骇璁剧疆</label>
      <param name="auto_rotate" type="bool" gui-text="鑷姩鏃嬭浆椤甸潰">false</param>
      <param name="reordering" type="optiongroup" appearance="combo" gui-text="璺緞浼樺寲绾у埆锛?>
        <option value="2">楂橈紝鍏佽鍙嶅悜閲嶆帓</option>
        <option value="1">涓紝閲嶆帓璺緞</option>
        <option value="0">浣庯紝浠呰繛鎺ョ浉閭昏矾寰?/option>
        <option value="4">鍏抽棴锛屼弗鏍间繚鎸佸師椤哄簭</option>
      </param>
      <param name="grbl_path_optim_mode" type="optiongroup" appearance="combo" gui-text="缁樺浘鏈鸿矾寰勪紭鍖栨。浣嶏細">
        <option value="aggressive">婵€杩?/option>
        <option value="standard">鏍囧噯</option>
        <option value="conservative">淇濆畧</option>
        <option value="off">鍏抽棴棰濆娓呯悊</option>
      </param>
      <param name="random_start" type="bool" gui-text="闂悎璺緞璧风偣闅忔満鍖?>false</param>
      <param name="resolution" type="optiongroup" appearance="combo" gui-text="鐢垫満鍒嗚鲸鐜囷細">
        <option value="1">楂樺垎杈ㄧ巼锛屾洿骞虫粦</option>
        <option value="2">浣庡垎杈ㄧ巼锛屾洿蹇?/option>
      </param>
      <param name="model" type="optiongroup" appearance="combo" gui-text="琛岀▼妯″瀷锛?>
        <option value="1">榛樿 300 x 218 mm</option>
        <option value="2">430 x 297 mm</option>
        <option value="3">595 x 218 mm</option>
        <option value="4">160 x 101.6 mm</option>
        <option value="5">864 x 594 mm</option>
        <option value="6">594 x 432 mm</option>
        <option value="7">190 x 140 mm</option>
      </param>
      <spacer />
      <param name="bounds_auto_scale" type="bool" gui-text="瓒婄晫鏃跺厛鑷姩缂╂斁鏁村浘">true</param>
      <param name="bounds_auto_scale_prompt" type="bool" gui-text="鑷姩缂╂斁鍓嶈闂?>false</param>
      <param name="auto_sparse_linework" type="bool" gui-text="鑷姩闄嶇骇瀵嗘帓绾跨">true</param>
      <param name="auto_sparse_line_mode" type="optiongroup" appearance="combo" gui-text="闄嶇骇寮哄害锛?>
        <option value="aggressive">婵€杩?/option>
        <option value="standard">鏍囧噯</option>
        <option value="conservative">淇濆畧</option>
        <option value="off">鍏抽棴</option>
      </param>
      <param name="hiding" type="bool" gui-text="闅愯棌绾垮幓闄?>false</param>
      <label>璇存槑锛氬綋鍓嶉粯璁ゆ槸鍏堢缉鏀鹃€傞厤鏈哄櫒琛岀▼锛屽啀鍋氱粯鍥炬満璺緞娓呯悊涓庨噸鎺掞紝瀵瑰瘑鎺掔嚎绋垮仛鑷姩闄嶇骇锛屾渶鍚庝繚鐣欒秺鐣岃鍒囦繚鎶ゃ€?/label>
      <spacer />
      <label appearance="header">鍧愭爣鏄犲皠</label>
      <label xml:space="preserve">鍧愭爣鏄犲皠鍒嗕袱灞傦細鍏堥€夋嫨鈥滈€昏緫鍘熺偣妯″紡鈥濓紝鍐嶆寜闇€鍙犲姞鈥滃弽杞?X / 鍙嶈浆 Y / 瀵硅皟 X/Y鈥濄€傞粯璁ゆ寜浣犵殑璁惧棰勮涓衡€滃乏涓?+ 鍙嶈浆 X + 瀵硅皟 X/Y鈥濄€傝繖閲屼綔鐢ㄤ簬宸ヤ綔鍧愭爣锛屼笉浼氭敼鍐?G53 鏈哄櫒鍧愭爣銆?/label>
      <param name="grbl_zero_xy_on_connect" type="bool" gui-text="杩炴帴鍚庤嚜鍔ㄥ皢褰撳墠浣嶇疆璁句负宸ヤ綔鍘熺偣">true</param>
      <param name="grbl_coordinate_origin" type="optiongroup" appearance="combo" gui-text="閫昏緫鍘熺偣妯″紡锛?>
        <option value="top_left">宸︿笂</option>
        <option value="top_right">鍙充笂</option>
        <option value="bottom_left">宸︿笅</option>
        <option value="bottom_right">鍙充笅</option>
        <option value="center">涓績</option>
      </param>
      <param name="grbl_axis_invert_x" type="bool" gui-text="鍙嶈浆 X 杞?>true</param>
      <param name="grbl_axis_invert_y" type="bool" gui-text="鍙嶈浆 Y 杞?>false</param>
      <param name="grbl_axis_swap_xy" type="bool" gui-text="瀵硅皟 X/Y">true</param>
      <spacer />
      <label appearance="header">Grbl 鍛戒护</label>
      <param name="grbl_pen_up_cmd" type="string" gui-text="鎶瑪鍛戒护锛?>G1 Z0 F3000</param>
      <param name="grbl_pen_down_cmd" type="string" gui-text="钀界瑪鍛戒护锛?>G1 Z5 F3000</param>
      <param name="grbl_disable_motors_cmd" type="string" gui-text="澶辫兘鐢垫満鍛戒护锛?>$MD</param>
    </page>

    <page name="resume" gui-text="缁х画/鍥為浂">
      <label appearance="header">缁х画缁樺浘涓庡洖闆?/label>
      <param name="resume_type" type="optiongroup" appearance="radio" gui-text="鎭㈠鏂瑰紡锛?>
        <option value="plot">缁х画缁樺浘</option>
        <option value="home">浠呭洖宸ヤ綔鍘熺偣</option>
      </param>
      <label xml:space="preserve">缁х画缁樺浘浼氳鍙?SVG 涓繚瀛樼殑鎭㈠淇℃伅銆傝嫢鍙槸鎯宠鏈哄櫒鍥炲埌宸ヤ綔鍘熺偣锛岃閫夋嫨鈥滀粎鍥炲伐浣滃師鐐光€濄€傚鏋滈渶瑕佹満姊板綊浣嶏紝璇峰埌鈥滃揩閫熻酱鎺р€濋〉鎵ц鈥滄満姊板綊浣嶏紙$H锛夆€濓紱鑻ラ渶瑕佸洖鏈哄櫒鍘熺偣蹇収锛屽垯鐢辨彃浠跺唴閮ㄦ寜 G53/鏈哄櫒鍧愭爣澶勭悊銆?/label>
    </page>

    <page name="sysinfo" gui-text="绯荤粺淇℃伅">
      <label appearance="header">绯荤粺淇℃伅</label>
      <label xml:space="preserve">鐐瑰嚮鈥滃簲鐢ㄢ€濆悗璇诲彇褰撳墠鎻掍欢鐗堟湰鍜屽凡杩炴帴鎺у埗鍣ㄤ俊鎭€?/label>
    </page>
  </param>

