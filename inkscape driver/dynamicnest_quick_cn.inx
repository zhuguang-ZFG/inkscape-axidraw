<dependency type="extension">org.inkscape.output.svg.inkscape</dependency>
<dependency type="executable" location="extensions">dynamicnest_control.py</dependency>

<param name="mode" type="notebook">

<page name="plot" gui-text="涓€閿粯鍥?>
<label appearance="header">涓€閿粯鍥?/label>
<label xml:space="preserve">榛樿浼氭寜 SVG 涓墍鏈夊彲瑙佸浘灞傜殑椤哄簭鐩存帴杈撳嚭锛屼笉闇€瑕佹墜鍔ㄦ寚瀹氬浘灞傚彿銆傞€氬父淇濇寔鈥滀覆鍙ｇ暀绌鸿嚜鍔ㄨ繛鎺モ€濆嵆鍙紝鍙湁鑷姩杩炴帴澶辫触鏃跺啀鎵嬪姩鎸囧畾涓插彛銆?/label>
<spacer />
<param name="copies" type="int" min="0" max="9999" gui-text="缁樺浘浠芥暟锛?>1</param>
<param name="preview" type="bool" gui-text="棰勮妯″紡锛堜粎妯℃嫙锛屼笉鍙戦€佷覆鍙ｏ級锛?>false</param>
<param name="auto_pause_between_layers" type="bool" gui-text="鎸夊浘灞傝嚜鍔ㄦ殏鍋?>true</param>
<param name="manual_pen_change" type="bool" gui-text="鍥惧眰鏆傚仠鏃惰繘鍏ユ崲绗旀祦绋?>true</param>
<param name="pen_change_to_home" type="bool" gui-text="鎹㈢瑪鏃跺厛鍥炲埌宸ヤ綔鍘熺偣">true</param>
<param name="grbl_return_to_origin_after_plot" type="bool" gui-text="瀹屾垚鍚庤嚜鍔ㄥ洖宸ヤ綔鍘熺偣">true</param>
<param name="auto_sparse_linework" type="bool" gui-text="鑷姩闄嶇骇瀵嗘帓绾跨">true</param>
<param name="grbl_path_optim_mode" type="optiongroup" appearance="combo" gui-text="缁樺浘鏈鸿矾寰勪紭鍖栨。浣嶏細">
  <option value="aggressive">婵€杩涳紙鎺ㄨ崘锛?/option>
  <option value="standard">鏍囧噯</option>
  <option value="conservative">淇濆畧</option>
  <option value="off">鍏抽棴棰濆娓呯悊</option>
</param>
<param name="auto_sparse_line_mode" type="optiongroup" appearance="combo" gui-text="闄嶇骇寮哄害锛?>
  <option value="aggressive">婵€杩涳紙鎺ㄨ崘锛?/option>
  <option value="standard">鏍囧噯</option>
  <option value="conservative">淇濆畧</option>
  <option value="off">鍏抽棴</option>
</param>
<label xml:space="preserve">濡傛灉姣忎釜鍥惧眰浠ｈ〃涓嶅悓棰滆壊鎴栦笉鍚岀瑪锛屽嬀閫夆€滄寜鍥惧眰鑷姩鏆傚仠鈥濆嵆鍙湪姣忎釜闈炵┖鍥惧眰寮€濮嬪墠鏆傚仠锛涘啀鍕鹃€夆€滃浘灞傛殏鍋滄椂杩涘叆鎹㈢瑪娴佺▼鈥濓紝璁惧浼氭姮绗斻€佸洖鍒板伐浣滃師鐐癸紝绛変綘鎹㈢瑪鍚庣户缁€傚綋鍓嶉粯璁ゆ洿鍋忓悜缁樺浘鏈烘晥鐜囷細璺緞浼樺寲妗ｄ綅鍜屽瘑鎺掔嚎闄嶇骇寮哄害閮介粯璁や娇鐢ㄢ€滄縺杩涒€濄€?/label>
</page>

<page name="coords" gui-text="鍧愭爣绯?>
<label appearance="header">鍧愭爣绯昏缃?/label>
<label xml:space="preserve">杩欓噷鍏堥€夐€昏緫鍘熺偣妯″紡锛屽啀鎸夐渶鍙犲姞 X/Y 鍙嶈浆鍜?XY 瀵硅皟銆傚綋鍓嶆帹鑽愰粯璁ゅ€煎凡缁忔寜浣犵殑璁惧棰勮濂斤細宸︿笂鍘熺偣銆佸弽杞?X銆佸璋?X/Y銆?/label>
