<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>路径优化（兼容旧版）</name>
  <id>command.dynamicnest.reorder</id>
  <dependency type="executable" location="extensions">dynamicnest_svg_reorder.py</dependency>

<label indent="5" appearance="header">璺緞浼樺寲宸ュ叿</label>

<label xml:space="preserve">
璇ュ伐鍏蜂細閲嶆柊鎺掑簭鏂囨。鍚勫浘灞備腑鐨勫璞★紝浠ュ噺灏戞姮绗旂Щ鍔ㄨ窛绂诲拰鎬昏€楁椂銆?</label>

<param name="reordering" gui-text="瀵硅薄鍒嗙粍澶勭悊" type="optiongroup" 
    appearance="radio" indent="2" >
<option value="2">鍦ㄧ粍鍐呴噸鎺?/option>
<option value="1">淇濈暀鍘熷垎缁?/option>
<option value="3">鎵撴暎鍚庨噸鎺?/option>
</param>

<label indent="3" xml:space="preserve">
v2.8锛岀増鏉冩墍鏈?2023 Evil Mad Scientist</label>


<effect needs-live-preview="false">
    <object-type>all</object-type>
    <effects-menu>
      <submenu name="DynamicNest 工具"/>
    </effects-menu>
  </effect>
  <script>
    <command location="extensions" interpreter="python">dynamicnest_svg_reorder.py</command>
  </script>
</inkscape-extension>


