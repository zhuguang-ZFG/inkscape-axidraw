<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>濉厖绾跨敓鎴?/name>
  <id>command.dynamicnest.hatch</id>
  <dependency type="extension">org.inkscape.output.svg.inkscape</dependency>
  <dependency type="executable" location="extensions">dynamicnest_hatch.py</dependency>

  <param name="tab" type="notebook">
    <page name="splash" gui-text="濉厖绾跨敓鎴?>
      <label xml:space="preserve">杩欎釜鎵╁睍浼氫负鍏ㄩ儴鎴栭€変腑鐨勯棴鍚堝浘褰㈢敓鎴愬線杩斿紡濉厖绾裤€備负浜嗘洿閫傚悎缁樺浘鏈猴紝榛樿鍙傛暟宸茬粡璋冩暣涓衡€滀笉杩囧瘑銆佷究浜庡嚭鍥锯€濈殑椋庢牸銆?/label>

      <param name="hatchSpacing" type="float" min="0.001" max="1000" indent="2" precision="3" gui-text="濉厖绾块棿璺?>2.4</param>

      <param name="units" type="optiongroup" appearance="combo" indent="4" gui-text="闂磋窛鍗曚綅锛?>
        <option value="3">mm</option>
        <option value="2">px</option>
        <option value="4">inch</option>
      </param>

      <param name="hatchAngle" type="float" min="-360" max="360" indent="4" gui-text="濉厖绾胯搴︼紙搴︼級">45</param>
      <param name="crossHatch" type="bool" indent="4" gui-text="浜ゅ弶濉厖">false</param>

      <separator />

      <param name="connect_bool" type="bool" indent="2" gui-text="杩炴帴鐩歌繎绔偣">true</param>
      <param name="hatchScope" type="float" min="1.1" max="5.0" indent="2" gui-text="绔偣杩炴帴鑼冨洿锛堟寜闂磋窛鍊嶆暟锛?>2.0</param>

      <separator />

      <param name="inset_bool" type="bool" indent="2" gui-text="濉厖杈圭紭鍐呯缉">true</param>
      <param name="inset_dist" type="float" min="0.001" max="1000" precision="3" indent="2" gui-text="鍐呯缉璺濈锛堟寜鎵€閫夊崟浣嶏級">0.3</param>

      <separator />

      <param name="tolerance" type="float" min="0.1" max="100" indent="2" gui-text="瀹瑰樊">3.0</param>
    </page>

    <page name="info" gui-text="甯姪">
      <label xml:space="preserve">濉厖绾块棿璺濊秺灏忥紝绾胯秺瀵嗭紝鐢熸垚璺緞瓒婂锛岀粯鍥炬椂闂翠篃瓒婇暱銆傚綋鍓嶉粯璁ゅ€?2.4 mm 鏇村亸鍚戣妭鐪佹椂闂达紝閫傚悎澶у鏁扮粯鍥句换鍔°€?/label>
      <label xml:space="preserve">寤鸿锛?澶ч潰绉～鍏咃細3.0 鍒?4.0 mm
鏅€氬浘褰細2.0 鍒?3.0 mm
绮剧粏灏忓浘锛?.2 鍒?1.8 mm</label>
      <label xml:space="preserve">鈥滀氦鍙夊～鍏呪€濅細鍐嶇敓鎴愪竴缁勫瀭鐩存柟鍚戠殑鎺掔嚎锛屽瘑搴﹀拰鑰楁椂閮戒細鎺ヨ繎缈诲€嶃€?/label>
      <label xml:space="preserve">鈥滆繛鎺ョ浉杩戠鐐光€濊兘鍑忓皯鎶瑪娆℃暟锛屼絾鑼冨洿杩囧ぇ鍙兘鏀瑰彉濉厖澶栬銆?/label>
      <label xml:space="preserve">鈥滃～鍏呰竟缂樺唴缂┾€濆彲浠ヨ鎺掔嚎绂昏疆寤撶◢寰€€寮€锛岄伩鍏嶈竟缂樿繃榛戙€?/label>
      <label xml:space="preserve">瀹瑰樊瓒婂ぇ锛岃创杈圭簿搴﹁秺浣庯紝浣嗚矾寰勬暟閲忛€氬父涔熶細鍑忓皯銆?/label>
    </page>
  </param>

  <effect needs-live-preview="true">
    <object-type>all</object-type>
    <effects-menu>
      <submenu name="DynamicNest 工具"/>
    </effects-menu>
  </effect>

  <script>
    <command location="extensions" interpreter="python">dynamicnest_hatch.py</command>
  </script>
</inkscape-extension>


